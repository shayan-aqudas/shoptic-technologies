---
import '../styles/global.css';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const base = import.meta.env.BASE_URL.replace(/\/$/, '');

const {
  title = 'Shoptic Technologies — High-Craft Mobile Software & Digital Studio',
  description = 'Shoptic Technologies crafts purposeful, high-performance mobile applications and privacy-first digital experiences.',
  ogImage = `${base}/images/shoptic-logo.svg`,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://shayan-aqudas.github.io');
const faviconSrc = `${base}/favicon.svg`;
---

<!doctype html>
<html lang="en" class="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href={faviconSrc} />
    <link rel="canonical" href={canonicalURL} />
    <meta name="generator" content={Astro.generator} />

    <!-- Primary Meta Tags -->
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Shoptic Technologies" />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Facebook / WhatsApp -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:site_name" content="Shoptic Technologies" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonicalURL} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImage} />

    <!-- Google Fonts: Plus Jakarta Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet" />
  </head>
  <body class="relative min-h-screen bg-[#09090B] text-[#F8FAFC] antialiased selection:bg-cyan-500/30 selection:text-cyan-200">
    <!-- Ambient Atmospheric Lighting -->
    <div class="fixed inset-0 pointer-events-none overflow-hidden -z-10">
      <!-- Top Center Warm Gold Halo -->
      <div class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[450px] rounded-full bg-gradient-to-b from-[#FFD56B]/10 via-[#E6A23C]/5 to-transparent blur-[140px] glow-orb-gold"></div>
      
      <!-- Center Right Deep Indigo Orb -->
      <div class="absolute top-1/3 -right-32 w-[650px] h-[650px] rounded-full bg-gradient-to-br from-[#253256]/25 via-[#161F38]/15 to-transparent blur-[150px] glow-orb-indigo"></div>
      
      <!-- Bottom Left Emerald Oasis Halo -->
      <div class="absolute bottom-10 -left-32 w-[550px] h-[550px] rounded-full bg-gradient-to-tr from-[#34D399]/10 via-[#059669]/5 to-transparent blur-[140px]"></div>

      <!-- Fine Star Dust / Noise Texture -->
      <div class="absolute inset-0 bg-[radial-gradient(#ffffff0a_1px,transparent_1px)] [background-size:28px_28px] opacity-70"></div>
    </div>

    <!-- Sticky Capsule Navbar -->
    <Navbar />

    <!-- Main Content -->
    <main class="relative z-10">
      <slot />
    </main>

    <!-- Footer -->
    <Footer />
  </body>
</html>
