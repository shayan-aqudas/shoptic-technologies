---
interface Props { num?: string; label: string; title: string; sub?: string; center?: boolean; }
const { num, label, title, sub, center = false } = Astro.props;
---

<div class:list={['section-head reveal', { center }]}>
  <div class="eyebrow">{num && <span class="num">{num} </span>}<span class="sl">//</span> {label}</div>
  <h2 class="h2 text-silver" set:html={title} />
  {sub && <p class="lead">{sub}</p>}
</div>
