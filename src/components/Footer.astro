---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="glass footer-card">
      <div>
        <img src={`${base}/images/shoptic-logo-full.svg`} alt="Shoptic Technologies" width="230" height="60" style="height:56px;width:auto" />
        <p class="body mt-5 max-w-sm text-[15px]">
          An independent software studio designing fast, privacy-first mobile apps and digital products.
        </p>
      </div>
      <div>
        <h4>// company</h4>
        <ul>
          <li><a href={`${base}/`}>Home</a></li>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/apps`}>Products</a></li>
          <li><a href={`${base}/contact`}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>// legal</h4>
        <ul>
          <li><a href={`${base}/privacy`}>Privacy Policy</a></li>
          <li><a href={`${base}/terms`}>Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <h4>// get in touch</h4>
        <ul>
          <li><a href="mailto:contact@shoptictechnologies.com">contact@shoptictechnologies.com</a></li>
          <li><a href="mailto:support@shoptictechnologies.com">support@shoptictechnologies.com</a></li>
          <li><a href="https://play.google.com/store/apps/details?id=com.nooraya.app" target="_blank" rel="noopener noreferrer">Nooraya on Google Play</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} Shoptic Technologies. All rights reserved.</span>
      <span>// always building<span class="caret" style="height:2px;width:9px;vertical-align:middle"></span></span>
    </div>
  </div>
</footer>
