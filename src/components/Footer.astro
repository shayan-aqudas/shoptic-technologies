---
import { PLAY_URL, STORE_URL, CONTACT_EMAIL, SUPPORT_EMAIL } from '../config';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap">
    <div class="glass footer-card">
      <div>
        <img src={`${base}/images/shoptic-logo-full.svg`} alt="Shoptic Technologies" width="230" height="60" style="height:56px;width:auto" />
        <p class="body mt-5 max-w-sm text-[15px]">
          An independent product company. We design, build and run our own apps and online stores.
        </p>
      </div>
      <div>
        <h4>// company</h4>
        <ul>
          <li><a href={`${base}/about`}>About</a></li>
          <li><a href={`${base}/apps`}>Products</a></li>
          <li><a href={`${base}/careers`}>Careers</a></li>
          <li><a href={`${base}/contact`}>Contact</a></li>
        </ul>
      </div>
      <div>
        <h4>// products</h4>
        <ul>
          <li><a href={PLAY_URL} target="_blank" rel="noopener noreferrer">Nooraya</a></li>
          <li><a href={STORE_URL} target="_blank" rel="noopener noreferrer">shoptic.store</a></li>
          <li><a href={`${base}/privacy`}>Privacy Policy</a></li>
          <li><a href={`${base}/terms`}>Terms of Service</a></li>
        </ul>
      </div>
      <div>
        <h4>// get in touch</h4>
        <ul>
          <li><a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a></li>
          <li><a href={`mailto:${SUPPORT_EMAIL}`}>{SUPPORT_EMAIL}</a></li>
        </ul>
      </div>
    </div>
    <div class="footer-bottom">
      <span>&copy; {year} Shoptic Technologies. All rights reserved.</span>
      <span>// always building<span class="caret" style="height:2px;width:9px;vertical-align:middle"></span></span>
    </div>
  </div>
</footer>
