---
import { Check, ArrowRight } from '@lucide/astro';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const caps = [
  'Full Quran with audio reciters',
  'Prayer times for your exact location',
  'Sensor-driven Qibla compass',
  'Duas and peaceful audio',
  'One-tap ringtones and Adhans',
  'Hadith books, light and fast',
];
const PLAY = 'https://play.google.com/store/apps/details?id=com.nooraya.app';
---

<div class="glass showcase reveal">
  <div class="glow" aria-hidden="true"></div>
  <div>
    <div class="app-head">
      <div class="glass app-icon" style="--r:22px"><img src={`${base}/images/nooraya-logo.webp`} alt="Nooraya app icon" width="64" height="64" /></div>
      <div>
        <div class="flex items-center gap-3 flex-wrap">
          <h3 class="text-3xl font-semibold tracking-tight">Nooraya</h3>
          <span class="status">Live on Google Play</span>
        </div>
        <p class="mono text-[12.5px] mt-1" style="color:var(--faint)">com.nooraya.app</p>
      </div>
    </div>
    <p class="body mt-6 text-[16.5px]">
      Our flagship Islamic lifestyle companion. A calm, modern dark interface with accurate prayer schedules,
      an animated Qibla compass, complete Quran recitations by renowned reciters, Hadith books and peaceful audio.
      {detailed && ' Built with on-device processing, offline-ready audio caching and a design that stays out of the way.'}
    </p>
    <div class="caps">
      {caps.map((c) => <div class="cap"><Check />{c}</div>)}
    </div>
    <div class="cta-row">
      <a href={PLAY} target="_blank" rel="noopener noreferrer" class="btn btn-primary">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M3.609 1.814 13.792 12 3.61 22.186a.68.68 0 0 1-.316-.583V2.397c0-.242.118-.459.315-.583zm11.37 11.37 2.42 2.42-12.012 6.864 9.592-9.284zm0-2.368L5.387 1.532l12.012 6.864-2.42 2.42zM16.166 12l2.844-2.844 3.738 2.136c.74.423.74 1.109 0 1.532l-3.738 2.136L16.166 12z"/></svg>
        Get it on Google Play
      </a>
      {detailed
        ? <a href={`${base}/privacy`} class="btn btn-glass">Privacy Policy</a>
        : <a href={`${base}/apps`} class="btn btn-glass">View details <ArrowRight class="go" /></a>}
    </div>
  </div>
  <div class="glass phone" style="--r:46px">
    <img src={`${base}/images/nooraya-screenshot.webp`} alt="Nooraya home screen" width="720" height="1608" loading="lazy" />
  </div>
</div>
