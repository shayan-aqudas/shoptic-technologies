---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const currentPath = Astro.url.pathname;

const navItems = [
  { name: 'Home', href: `${base}/` },
  { name: 'About', href: `${base}/about` },
  { name: 'Apps', href: `${base}/apps` },
  { name: 'Privacy Policy', href: `${base}/privacy` },
  { name: 'Terms', href: `${base}/terms` },
  { name: 'Contact', href: `${base}/contact` },
];

const logoSrc = `${base}/images/shoptic-logo.svg`;
---

<header class="sticky top-4 z-50 max-w-6xl mx-auto px-4 sm:px-6 transition-all duration-300">
  <nav class="glass-nav rounded-2xl px-5 py-3.5 flex items-center justify-between">
    <!-- Brand Logo -->
    <a href={`${base}/`} class="flex items-center gap-3 group">
      <img src={logoSrc} alt="Shoptic Technologies Logo" class="w-9 h-9 rounded-xl transition-transform duration-300 group-hover:scale-105" />
      <div class="flex flex-col">
        <span class="font-bold text-base sm:text-lg tracking-tight text-white group-hover:text-cyan-400 transition-colors">
          Shoptic <span class="text-cyan-400 font-light">Technologies</span>
        </span>
        <span class="text-[10px] tracking-wider uppercase text-gray-400 font-medium hidden sm:block">Digital Software Studio</span>
      </div>
    </a>

    <!-- Desktop Navigation Links -->
    <div class="hidden md:flex items-center gap-1 lg:gap-2">
      {navItems.map((item) => {
        const isHome = item.href === `${base}/` || item.href === base;
        const isActive = isHome ? (currentPath === `${base}/` || currentPath === base) : currentPath.startsWith(item.href);
        return (
          <a
            href={item.href}
            class={`px-3.5 py-1.5 rounded-xl text-sm font-medium transition-all duration-200 ${
              isActive
                ? 'bg-white/10 text-cyan-300 shadow-inner border border-white/10'
                : 'text-gray-300 hover:text-white hover:bg-white/5'
            }`}
          >
            {item.name}
          </a>
        );
      })}
    </div>

    <!-- Right Action & Mobile Toggle -->
    <div class="flex items-center gap-3">
      <a
        href={`${base}/contact`}
        class="hidden sm:inline-flex items-center gap-2 px-4 py-2 rounded-xl text-xs sm:text-sm font-semibold glass-button-primary cursor-pointer"
      >
        <span>Get in Touch</span>
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>

      <!-- Mobile Hamburger Button -->
      <button
        id="mobile-menu-btn"
        type="button"
        class="md:hidden p-2 rounded-xl text-gray-300 hover:text-white hover:bg-white/10 focus:outline-none"
        aria-label="Toggle menu"
      >
        <svg id="menu-icon-open" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="menu-icon-close" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </nav>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden mt-2 glass-panel rounded-2xl p-4 shadow-2xl space-y-2 border border-white/10">
    {navItems.map((item) => {
      const isHome = item.href === `${base}/` || item.href === base;
      const isActive = isHome ? (currentPath === `${base}/` || currentPath === base) : currentPath.startsWith(item.href);
      return (
        <a
          href={item.href}
          class={`block px-4 py-2.5 rounded-xl text-sm font-medium transition-all ${
            isActive
              ? 'bg-cyan-500/20 text-cyan-300 border border-cyan-500/30'
              : 'text-gray-300 hover:text-white hover:bg-white/5'
          }`}
        >
          {item.name}
        </a>
      );
    })}
    <div class="pt-2 border-t border-white/10">
      <a
        href={`${base}/contact`}
        class="block w-full text-center px-4 py-2.5 rounded-xl text-sm font-semibold glass-button-primary"
      >
        Get in Touch
      </a>
    </div>
  </div>
</header>

<script>
  const btn = document.getElementById('mobile-menu-btn');
  const menu = document.getElementById('mobile-menu');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  if (btn && menu && openIcon && closeIcon) {
    btn.addEventListener('click', () => {
      menu.classList.toggle('hidden');
      openIcon.classList.toggle('hidden');
      closeIcon.classList.toggle('hidden');
    });
  }
</script>
