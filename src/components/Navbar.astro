---
import { ArrowRight, ArrowUpRight, Menu, X } from '@lucide/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const links = [
  { name: 'Home', href: `${base}/` },
  { name: 'About', href: `${base}/about` },
  { name: 'Products', href: `${base}/apps` },
  { name: 'Careers', href: `${base}/careers` },
  { name: 'Contact', href: `${base}/contact` },
];
const isActive = (href: string) => {
  const h = href.replace(/\/$/, '') || '/';
  return h === (base || '/') ? path === h || path === '/' : path.startsWith(h);
};
---

<header class="nav" id="nav">
  <nav class="glass nav-pill" aria-label="Main">
    <a href={`${base}/`} class="nav-logo" aria-label="Shoptic Technologies home">
      <img class="nav-icon" src={`${base}/images/shoptic-icon.svg`} alt="" width="42" height="42" />
      <img class="nav-word" src={`${base}/images/shoptic-wordmark.svg`} alt="Shoptic Technologies" width="134" height="28" />
    </a>
    <div class="nav-links">
      {links.map((l) => <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.name}</a>)}
    </div>
    <div class="flex items-center gap-2">
      <a href={`${base}/apps`} class="btn btn-primary btn-sm nav-cta">
        Our products <ArrowRight class="go" />
      </a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false">
        <Menu class="i-open" /><X class="i-close" style="display:none" />
      </button>
    </div>
  </nav>
  <div class="glass glass-strong mobile-menu" id="mobile-menu">
    {links.map((l) => <a href={l.href} class={isActive(l.href) ? 'active' : ''}>{l.name}<ArrowUpRight /></a>)}
    <a href={`${base}/privacy`}>Privacy Policy<ArrowUpRight /></a>
    <a href={`${base}/apps`} class="btn btn-primary mt-2" style="justify-content:center;color:#fff">Our products</a>
  </div>
</header>

<script>
  const nav = document.getElementById('nav');
  const btn = document.getElementById('menu-btn');
  const onScroll = () => nav?.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    btn.setAttribute('aria-expanded', String(open));
    (btn.querySelector('.i-open') as HTMLElement).style.display = open ? 'none' : '';
    (btn.querySelector('.i-close') as HTMLElement).style.display = open ? '' : 'none';
  });
</script>
