---
import { ArrowRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section">
  <div class="wrap">
    <div class="glass cta reveal">
      <div class="orb" aria-hidden="true"></div>
      <div class="eyebrow"><span class="sl">//</span> let's build</div>
      <h2 class="h2 text-silver mt-4">Have an idea worth building<span class="caret"></span></h2>
      <p class="lead">Tell us what you have in mind. We reply to every message within 24 to 48 business hours.</p>
      <div class="cta-row">
        <a href={`${base}/contact`} class="btn btn-primary">Start a conversation <ArrowRight class="go" /></a>
        <a href="mailto:contact@shoptictechnologies.com" class="btn btn-glass mono" style="font-size:14px">contact@shoptictechnologies.com</a>
      </div>
    </div>
  </div>
</section>
