---
import { ArrowRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="section">
  <div class="wrap">
    <div class="glass cta reveal">
      <div class="orb" aria-hidden="true"></div>
      <div class="eyebrow"><span class="sl">//</span> say hello</div>
      <h2 class="h2 text-silver mt-4">Let’s talk<span class="caret"></span></h2>
      <p class="lead">Questions about our products, partnerships or working with us? We reply to every message within 24 to 48 business hours.</p>
      <div class="cta-row">
        <a href={`${base}/contact`} class="btn btn-primary">Contact us <ArrowRight class="go" /></a>
        <a href={`${base}/careers`} class="btn btn-glass">Careers at Shoptic</a>
      </div>
    </div>
  </div>
</section>
