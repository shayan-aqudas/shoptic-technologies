---
import Layout from '../layouts/Layout.astro';
import { ArrowRight } from '@lucide/astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout title="Page not found — Shoptic Technologies" description="This page does not exist.">
  <section class="page-hero" style="min-height:70vh">
    <div class="wrap">
      <div class="eyebrow reveal"><span class="sl">//</span> error 404</div>
      <h1 class="display reveal mt-6" style="--d:80ms;font-size:clamp(2.5rem,5.6vw,4.8rem)">
        <span class="text-silver">This page</span><br /><span class="text-ember">does not exist</span><span class="caret"></span>
      </h1>
      <p class="lead reveal mt-6 max-w-xl" style="--d:160ms">The link may be old or mistyped. Let’s get you back on track.</p>
      <div class="cta-row reveal" style="--d:240ms">
        <a href={`${base}/`} class="btn btn-primary">Back to home <ArrowRight class="go" /></a>
        <a href={`${base}/apps`} class="btn btn-glass">Our products</a>
      </div>
    </div>
  </section>
</Layout>
