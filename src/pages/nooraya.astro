---
// Standalone high-converting landing & Play Store smart-redirect page for Nooraya
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Nooraya: Sacred Quran, Azan &amp; Ringtones</title>
    
    <!-- Meta Tags for SEO & Social Previews (Meta Ads & WhatsApp) -->
    <meta name="description" content="Download Nooraya on Google Play Store. Listen to soulful Quran recitations, soothing azans, and beautiful Islamic ringtones.">
    <meta property="og:title" content="Nooraya — Sacred Quran &amp; Islamic Ringtones">
    <meta property="og:description" content="Download free on Google Play Store. Ad-free audio, offline recitations, and soulful ringtones for your phone.">
    <meta property="og:image" content="https://shoptic.co.in/nooraya/icon.png">
    <meta property="og:url" content="https://shoptic.co.in/nooraya">
    <meta property="og:type" content="website">
    <meta name="theme-color" content="#051814">
    <link rel="icon" type="image/png" href="/nooraya/icon.png" />
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&family=Amiri:wght@700&display=swap" rel="stylesheet">
    <script async src="https://www.googletagmanager.com/gtm.js?id=GTM-PJN6FC8R"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
    </script>
    <style is:inline>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
            background: radial-gradient(circle at 50% 0%, #0d382c 0%, #051814 50%, #020b09 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            padding: 24px 16px;
            overflow-x: hidden;
            position: relative;
        }

        .ambient-glow {
            position: absolute;
            top: -100px;
            left: 50%;
            transform: translateX(-50%);
            width: 440px;
            height: 440px;
            background: radial-gradient(circle, rgba(16, 185, 129, 0.28) 0%, rgba(5, 24, 20, 0) 70%);
            pointer-events: none;
            z-index: 0;
        }

        .card {
            position: relative;
            z-index: 1;
            background: rgba(22, 36, 31, 0.78);
            backdrop-filter: blur(28px);
            -webkit-backdrop-filter: blur(28px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 32px;
            padding: 40px 24px;
            max-width: 420px;
            width: 100%;
            text-align: center;
            box-shadow: 0 24px 60px rgba(0, 0, 0, 0.65), 0 0 40px rgba(16, 185, 129, 0.12);
            animation: fadeIn 0.6s cubic-bezier(0.16, 1, 0.3, 1);
        }

        @keyframes fadeIn {
            from { opacity: 0; transform: translateY(16px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .app-icon-wrap {
            position: relative;
            width: 104px;
            height: 104px;
            margin: 0 auto 20px auto;
        }

        .app-icon {
            width: 104px;
            height: 104px;
            border-radius: 26px;
            object-fit: cover;
            box-shadow: 0 12px 28px rgba(0, 0, 0, 0.5), 0 0 26px rgba(16, 185, 129, 0.35);
            border: 2px solid rgba(255, 255, 255, 0.18);
        }

        .badge-verified {
            position: absolute;
            bottom: -5px;
            right: -5px;
            background: #10B981;
            color: #ffffff;
            border-radius: 50%;
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 14px;
            font-weight: 800;
            border: 2.5px solid #08211b;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.4);
        }

        h1 {
            font-size: 26px;
            font-weight: 800;
            letter-spacing: -0.4px;
            margin-bottom: 4px;
            background: linear-gradient(135deg, #ffffff 60%, #a7f3d0 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .arabic-name {
            font-family: 'Amiri', serif;
            font-size: 20px;
            color: #facc15;
            margin-bottom: 10px;
            display: block;
        }

        .tagline {
            font-size: 13.5px;
            color: #94a3b8;
            line-height: 1.5;
            margin-bottom: 22px;
            padding: 0 8px;
        }

        .rating-strip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            padding: 6px 14px;
            font-size: 12.5px;
            color: #e2e8f0;
            margin-bottom: 24px;
        }

        .star {
            color: #fbbf24;
            font-size: 14px;
        }

        .redirect-status {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            font-size: 13.5px;
            color: #34d399;
            font-weight: 600;
            margin-bottom: 18px;
        }

        .spinner {
            width: 18px;
            height: 18px;
            border: 2px solid rgba(52, 211, 153, 0.25);
            border-top-color: #34d399;
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
        }

        @keyframes spin {
            to { transform: rotate(360deg); }
        }

        .btn-playstore {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            width: 100%;
            padding: 16px 20px;
            background: linear-gradient(135deg, #10B981 0%, #059669 100%);
            color: #ffffff;
            text-decoration: none;
            border-radius: 20px;
            font-weight: 700;
            font-size: 16px;
            box-shadow: 0 10px 24px rgba(16, 185, 129, 0.35);
            transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            cursor: pointer;
        }

        .btn-playstore:active {
            transform: scale(0.97);
            box-shadow: 0 6px 16px rgba(16, 185, 129, 0.45);
        }

        .btn-playstore svg {
            width: 24px;
            height: 24px;
            fill: currentColor;
        }

        .manual-hint {
            font-size: 12px;
            color: #64748b;
            margin-top: 14px;
        }

        .features {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            gap: 8px;
            margin-top: 26px;
            padding-top: 18px;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
        }

        .feature-pill {
            background: rgba(255, 255, 255, 0.04);
            border: 1px solid rgba(255, 255, 255, 0.06);
            border-radius: 12px;
            padding: 6px 10px;
            font-size: 11.5px;
            color: #cbd5e1;
        }

        footer {
            margin-top: 24px;
            text-align: center;
            font-size: 12px;
            color: #64748b;
            z-index: 1;
        }

        footer a {
            color: #94a3b8;
            text-decoration: none;
            margin: 0 6px;
        }

        footer a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="ambient-glow"></div>

    <div class="card">
        <div class="app-icon-wrap">
            <img src="/nooraya/icon.png" alt="Nooraya App Icon" class="app-icon" width="104" height="104">
            <div class="badge-verified">✓</div>
        </div>

        <h1>Nooraya</h1>
        <span class="arabic-name">نورایا — القرآن والأذكار</span>

        <p class="tagline">Soulful Quran Recitations, Accurate Azan &amp; Sacred Islamic Ringtones</p>

        <div class="rating-strip">
            <span class="star">★</span>
            <strong>4.9</strong>
            <span>• Verified by Google Play Protect</span>
        </div>

        <div class="redirect-status" id="redirectStatus">
            <div class="spinner"></div>
            <span>Opening Google Play Store...</span>
        </div>

        <a href="https://play.google.com/store/apps/details?id=com.nooraya.app" id="playBtn" class="btn-playstore">
            <svg viewBox="0 0 24 24">
                <path d="M3.609 1.814L13.792 12 3.61 22.186a1.597 1.597 0 0 1-.61-.954V2.768c0-.38.163-.733.61-.954zm11.235 11.236L18.7 15.26l-13.067 7.545 9.21-9.755zm0-2.1L5.633 1.196 18.7 8.74l-3.856 2.21zm1.455.842l2.946-1.692c.797-.458.797-1.206 0-1.664l-2.946-1.693-1.077 1.693 1.077 1.693z"/>
            </svg>
            Download on Google Play
        </a>

        <p class="manual-hint">If the app doesn't open automatically, tap the button above.</p>

        <div class="features">
            <span class="feature-pill">✨ 50+ Top Reciters</span>
            <span class="feature-pill">🎵 Islamic Ringtones</span>
            <span class="feature-pill">🕌 Accurate Azan</span>
            <span class="feature-pill">⚡ 100% Free</span>
        </div>
    </div>

    <footer>
        <p>© 2026 Nooraya • A product of <a href="https://shoptic.co.in/" style="color:#10b981;font-weight:600;text-decoration:none;">Shoptic Technologies</a></p>
        <p style="margin-top: 6px;">
            <a href="https://shayan-aqudas.github.io/nooraya-policy/">Privacy Policy</a> • 
            <a href="https://shayan-aqudas.github.io/nooraya-policy/terms.html">Terms of Service</a>
        </p>
    </footer>

    <!-- Smart Redirect Script for Meta Ads & Instagram In-App Browser -->
    <script is:inline>
        const playStoreWebUrl = 'https://play.google.com/store/apps/details?id=com.nooraya.app';
        const playStoreAppUri = 'market://details?id=com.nooraya.app';

        function launchPlayStore() {
            const isAndroid = /Android/i.test(navigator.userAgent);
            
            if (isAndroid) {
                // Try opening native Google Play Store app directly
                window.location.href = playStoreAppUri;
                
                // Fallback to web URL in case market:// doesn't trigger
                setTimeout(function() {
                    window.location.href = playStoreWebUrl;
                }, 1000);
            } else {
                // Non-Android or desktop: redirect directly to Play Store web page
                window.location.href = playStoreWebUrl;
            }
        }

        // Auto trigger redirect on load after 1000ms for smooth visual transition
        window.addEventListener('load', function() {
            setTimeout(launchPlayStore, 1000);
        });

        // Click handler for manual tap
        document.getElementById('playBtn').addEventListener('click', function(e) {
            const isAndroid = /Android/i.test(navigator.userAgent);
            if (isAndroid) {
                e.preventDefault();
                window.location.href = playStoreAppUri;
                setTimeout(function() {
                    window.location.href = playStoreWebUrl;
                }, 1000);
            }
        });
    </script>
</body>
</html>
