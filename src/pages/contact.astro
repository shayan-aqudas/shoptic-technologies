---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact & Support — Shoptic Technologies"
  description="Get in touch with Shoptic Technologies for app support, developer inquiries, and business partnerships."
>
  <div class="max-w-5xl mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-20">
    <!-- Header -->
    <div class="text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-panel text-xs font-medium text-cyan-300 border border-cyan-500/30">
        <span>Support & Communication Desk</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        We're Here to <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-emerald-400 to-indigo-400">Help</span>.
      </h1>
      <p class="text-gray-400 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        Whether you have feedback on Nooraya, need assistance with your subscription, or want to explore collaboration, send us a note.
      </p>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
      <!-- Contact Info Cards (Col 1) -->
      <div class="lg:col-span-5 space-y-4">
        <!-- Card 1 -->
        <div class="glass-card rounded-2xl p-6 space-y-3">
          <div class="w-10 h-10 rounded-xl glass-panel flex items-center justify-center text-cyan-400 text-lg border border-cyan-500/30">
            ✉️
          </div>
          <h3 class="text-base font-bold text-white">App Support & Bugs</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            For technical inquiries, prayer time verification, or bug reports regarding Nooraya:
          </p>
          <a href="mailto:support@shoptictechnologies.com" class="text-xs font-semibold text-cyan-400 hover:underline block">
            support@shoptictechnologies.com
          </a>
        </div>

        <!-- Card 2 -->
        <div class="glass-card rounded-2xl p-6 space-y-3">
          <div class="w-10 h-10 rounded-xl glass-panel flex items-center justify-center text-emerald-400 text-lg border border-emerald-500/30">
            🤝
          </div>
          <h3 class="text-base font-bold text-white">General & Partnerships</h3>
          <p class="text-xs text-gray-400 leading-relaxed">
            For developer outreach, business proposals, and studio queries:
          </p>
          <a href="mailto:contact@shoptictechnologies.com" class="text-xs font-semibold text-emerald-400 hover:underline block">
            contact@shoptictechnologies.com
          </a>
        </div>

        <!-- Card 3 -->
        <div class="glass-card rounded-2xl p-6 space-y-2">
          <div class="flex items-center gap-2 text-xs font-semibold text-white">
            <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
            <span>Response Time SLA</span>
          </div>
          <p class="text-xs text-gray-400 leading-relaxed">
            Our engineering team reviews all incoming support tickets promptly. We generally respond within <strong>24 to 48 business hours</strong>.
          </p>
        </div>
      </div>

      <!-- Interactive Contact Form (Col 2) -->
      <div class="lg:col-span-7">
        <div class="glass-card rounded-3xl p-6 sm:p-10 border border-white/10">
          <h3 class="text-xl font-bold text-white tracking-tight mb-2">Send a Message</h3>
          <p class="text-xs text-gray-400 mb-6">Fill in the form below and we will get back to your email.</p>

          <form id="contact-form" class="space-y-4">
            <div>
              <label for="name" class="block text-xs font-semibold text-gray-300 mb-1.5">Your Name</label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="e.g. Shayan Aqudas"
                class="w-full px-4 py-3 rounded-xl glass-input text-sm placeholder:text-gray-500"
              />
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-gray-300 mb-1.5">Email Address</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="you@example.com"
                class="w-full px-4 py-3 rounded-xl glass-input text-sm placeholder:text-gray-500"
              />
            </div>

            <div>
              <label for="subject" class="block text-xs font-semibold text-gray-300 mb-1.5">Subject / Topic</label>
              <select
                id="subject"
                name="subject"
                class="w-full px-4 py-3 rounded-xl glass-input text-sm bg-[#0C1220]"
              >
                <option value="nooraya-support">Nooraya App Support</option>
                <option value="bug-report">Bug / Defect Report</option>
                <option value="feature-request">Feature Request</option>
                <option value="privacy">Privacy / Data Inquiry</option>
                <option value="business">Business / General Collaboration</option>
              </select>
            </div>

            <div>
              <label for="message" class="block text-xs font-semibold text-gray-300 mb-1.5">Message</label>
              <textarea
                id="message"
                name="message"
                rows="4"
                required
                placeholder="Tell us how we can assist you..."
                class="w-full px-4 py-3 rounded-xl glass-input text-sm placeholder:text-gray-500 resize-none"
              ></textarea>
            </div>

            <button
              type="submit"
              id="submit-btn"
              class="w-full py-3.5 rounded-xl text-sm font-semibold glass-button-primary cursor-pointer flex items-center justify-center gap-2"
            >
              <span>Transmit Message</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </button>
          </form>

          <!-- Success Alert Message -->
          <div id="form-success" class="hidden mt-4 p-4 rounded-xl glass-panel border border-emerald-500/40 bg-emerald-500/10 text-emerald-300 text-xs text-center">
            ✔ Thank you! Your message has been routed to our team. We will reply to your email shortly.
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const successBox = document.getElementById('form-success');
  const submitBtn = document.getElementById('submit-btn');

  if (form && successBox && submitBtn) {
    form.addEventListener('submit', (e) => {
      e.preventDefault();
      submitBtn.setAttribute('disabled', 'true');
      submitBtn.classList.add('opacity-50');
      
      setTimeout(() => {
        form.reset();
        submitBtn.removeAttribute('disabled');
        submitBtn.classList.remove('opacity-50');
        successBox.classList.remove('hidden');
      }, 600);
    });
  }
</script>
