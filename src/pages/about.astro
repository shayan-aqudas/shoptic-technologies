---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import CTA from '../components/CTA.astro';
import { Gauge, Lock, Layers, LifeBuoy, ArrowRight } from '@lucide/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const principles = [
  { icon: Gauge, t: 'Smooth by default', d: 'Every animation and layout is profiled on real devices so transitions stay fluid, without dropped frames.' },
  { icon: Lock, t: 'Privacy by default', d: 'Calculations and sensor data stay on the user’s device wherever possible. We never sell personal data.' },
  { icon: Layers, t: 'Tactile craftsmanship', d: 'Translucency, depth and careful motion that make software feel calm and physical to use.' },
  { icon: LifeBuoy, t: 'Active stewardship', d: 'Continuous testing, timely Android platform updates and quick, human support after launch.' },
];
const stack = ['Flutter & Dart', 'Kotlin / Android native', 'Astro', 'Tailwind CSS', 'Firebase', 'SQLite', 'Cloudflare'];
---

<Layout title="About — Shoptic Technologies" description="Shoptic Technologies is an independent product company building and running its own apps and online stores, including Nooraya and shoptic.store.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow reveal"><span class="sl">//</span> about us</div>
      <h1 class="display reveal mt-6" style="--d:80ms;font-size:clamp(2.5rem,5.6vw,4.8rem)">
        <span class="text-silver">Software that respects</span><br /><span class="text-ember">the people who use it</span><span class="caret"></span>
      </h1>
      <p class="lead reveal mt-6 max-w-2xl" style="--d:160ms">
        We are an independent product company. We don’t take client work: we design, build and run our own products, today Nooraya and shoptic.store, with more on the way.
      </p>
    </div>
  </section>

  <section class="wrap">
    <div class="cards-2">
      <div class="glass card reveal">
        <div class="eyebrow"><span class="num">01 </span><span class="sl">//</span> our mission</div>
        <h2 class="h3 mt-5" style="font-size:1.7rem">Fast, beautiful and respectful of your attention.</h2>
        <p class="body mt-4">Our starting point is simple: digital products should be fast, a pleasure to look at, and respectful of the user’s attention and privacy.</p>
        <p class="body mt-4">Too many apps trade experience for aggressive tracking, battery-draining background work and cluttered screens. We build products that deliver calm, precision and genuine usefulness instead, whether it is an app on your phone or a watch from <a href="https://shoptic.store" target="_blank" rel="noopener noreferrer" class="text-white underline decoration-white/30 underline-offset-4">shoptic.store</a>.</p>
      </div>
      <div class="glass card reveal" style="--d:100ms">
        <div class="eyebrow"><span class="num">02 </span><span class="sl">//</span> the nooraya journey</div>
        <h2 class="h3 mt-5" style="font-size:1.7rem">Our flagship, built and maintained in-house.</h2>
        <p class="body mt-4"><strong class="text-white font-medium">Nooraya</strong> was created to change how Muslims around the world connect with daily prayer, the Holy Quran and authentic Islamic literature.</p>
        <p class="body mt-4">A bespoke, tactile interface, accurate astronomical calculations and offline-ready audio caching make it the clearest example of what our studio stands for.</p>
        <a href={`${base}/apps`} class="btn btn-glass btn-sm mt-6">See Nooraya <ArrowRight class="go" /></a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead num="03" label="engineering principles" title="Four rules we never break." />
      <div class="cards-4">
        {principles.map((p, i) => (
          <div class="glass card lift reveal" style={`--d:${i * 80}ms`}>
            <div class="icon-tile"><p.icon /></div>
            <h3 class="h3">{p.t}</h3>
            <p class="body">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <SectionHead num="04" label="technology" title="A focused, proven stack." sub="Robust, modern technology chosen for stability and room to scale." />
      <div class="flex flex-wrap gap-3 reveal">
        {stack.map((t) => <span class="chip" style="font-size:14px;padding:.75rem 1.2rem;color:var(--text)"><span class="dot"></span>{t}</span>)}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
