---
import Layout from '../layouts/Layout.astro';
import SectionHead from '../components/SectionHead.astro';
import Nooraya from '../components/Nooraya.astro';
import Store from '../components/Store.astro';
import CTA from '../components/CTA.astro';
import { BookOpen, Clock, Compass, Headphones, BellRing, Smartphone, Timer, ListChecks } from '@lucide/astro';

const features = [
  { icon: BookOpen, t: 'Complete Quran', d: 'Every surah with audio from renowned reciters, ready to stream or cache for offline listening.' },
  { icon: Clock, t: 'Accurate prayer times', d: 'Astronomical calculations for your exact location, with timely Adhan reminders.' },
  { icon: Compass, t: 'Qibla compass', d: 'A smooth, sensor-driven compass that points toward the Kaaba from wherever you are.' },
  { icon: Headphones, t: 'Duas & peaceful audio', d: 'A calm library of duas and recitations for every moment of the day.' },
  { icon: BellRing, t: 'Ringtones & Adhans', d: 'Set a sacred ringtone, Adhan or alarm tone in a single tap.' },
  { icon: Smartphone, t: 'Light and focused', d: 'A clean, portrait-first design without clutter, built to stay fast on everyday phones.' },
];
const pipeline = [
  { icon: Timer, t: 'Focus & mindfulness utility', s: 'In architecture', d: 'A minimalist deep-focus timer and soundscape generator with gentle, tactile animations.' },
  { icon: ListChecks, t: 'Smart routine & habit tracker', s: 'Prototyping', d: 'An offline-first habit tracker with on-device storage, no subscription fatigue and helpful widgets.' },
];
---

<Layout title="Products — Shoptic Technologies" description="Products built and run by Shoptic Technologies: Nooraya, the Islamic lifestyle app on Google Play, and shoptic.store, our online watch store.">
  <section class="page-hero">
    <div class="wrap">
      <div class="eyebrow reveal"><span class="sl">//</span> our products</div>
      <h1 class="display reveal mt-6" style="--d:80ms;font-size:clamp(2.5rem,5.6vw,4.8rem)">
        <span class="text-silver">Products we build</span><br /><span class="text-ember">and run ourselves</span><span class="caret"></span>
      </h1>
      <p class="lead reveal mt-6 max-w-2xl" style="--d:160ms">An app used every day and an online store, both designed, built and looked after by our own team.</p>
    </div>
  </section>

  <section class="wrap">
    <Nooraya detailed />
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead num="01" label="inside nooraya" title="Everything for the day, in one calm app." />
      <div class="cards-3">
        {features.map((f, i) => (
          <div class="glass card lift reveal" style={`--d:${(i % 3) * 80}ms`}>
            <div class="icon-tile"><f.icon /></div>
            <h3 class="h3">{f.t}</h3>
            <p class="body">{f.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section" id="store" style="padding-top:0;scroll-margin-top:90px">
    <div class="wrap">
      <SectionHead num="02" label="shoptic.store" title="Great watches,<br/>honest prices." sub="Our online watch store, run by the same team and held to the same standard as our apps." />
      <Store />
    </div>
  </section>

  <section class="section" style="padding-top:0">
    <div class="wrap">
      <SectionHead num="03" label="in the lab" title="What we are building next." sub="Projects our team is designing right now. Roadmap 2026." />
      <div class="cards-2">
        {pipeline.map((p, i) => (
          <div class="glass card lift reveal" style={`--d:${i * 100}ms`}>
            <div class="flex items-center justify-between gap-4">
              <div class="icon-tile"><p.icon /></div>
              <span class="status warm">{p.s}</span>
            </div>
            <h3 class="h3">{p.t}</h3>
            <p class="body">{p.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
