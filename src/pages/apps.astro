---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const noorayaLogo = `${base}/images/nooraya-logo.png`;
const noorayaScreenshot = `${base}/images/nooraya-screenshot.png`;
---

<Layout
  title="Our Apps & Products — Shoptic Technologies"
  description="Explore mobile apps crafted by Shoptic Technologies including our flagship Islamic lifestyle companion Nooraya."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-20 pb-20">
    <!-- Header -->
    <div class="text-center space-y-4 mb-16">
      <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full glass-panel text-xs font-medium text-emerald-300 border border-emerald-500/30">
        <span>Software Portfolio</span>
      </div>
      <h1 class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
        Apps Built with <span class="text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 via-cyan-400 to-indigo-400">Precision</span>.
      </h1>
      <p class="text-gray-400 text-base sm:text-lg max-w-xl mx-auto leading-relaxed">
        Discover our released and upcoming mobile applications designed for mindful daily living and functional beauty.
      </p>
    </div>

    <!-- Flagship App: Nooraya Detailed Profile -->
    <div class="glass-card rounded-3xl p-6 sm:p-10 lg:p-12 mb-16 border border-white/10 relative overflow-hidden">
      <!-- Glow ambient background -->
      <div class="absolute top-0 right-0 w-96 h-96 bg-cyan-500/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <!-- Content -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-4">
            <img src={noorayaLogo} alt="Nooraya App Icon" class="w-20 h-20 rounded-2xl shadow-2xl border border-white/15" />
            <div>
              <div class="flex items-center gap-2">
                <h2 class="text-3xl font-extrabold text-white tracking-tight">Nooraya</h2>
                <span class="px-2.5 py-0.5 rounded-full text-[10px] font-semibold bg-emerald-500/20 text-emerald-300 border border-emerald-500/30">
                  Active Release
                </span>
              </div>
              <p class="text-xs text-gray-400 mt-1 font-medium">Package: <code>com.nooraya.app</code> • Version 1.0.3</p>
            </div>
          </div>

          <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
            Nooraya is an all-in-one sacred companion crafted for Android users. Built using a bespoke liquid glass dark interface, Nooraya delivers verified prayer timetables, smooth animated Qibla navigation, authentic Hadith books, verse-by-verse Quran recitations, and relaxing sacred audio.
          </p>

          <!-- Specifications List -->
          <div class="space-y-3 pt-2">
            <h3 class="text-xs font-bold uppercase tracking-wider text-cyan-400">Core Feature Capabilities</h3>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs text-gray-300">
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>Full Quran with Audio Reciters</span>
              </div>
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>Precise Location Prayer Timings</span>
              </div>
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>Haptic Sensor Qibla Compass</span>
              </div>
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>Sukoon Duas & Peaceful Audio</span>
              </div>
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>1-Tap Sacred Ringtones & Adhans</span>
              </div>
              <div class="flex items-center gap-2 glass-panel p-2.5 rounded-xl">
                <span class="text-cyan-400">✔</span>
                <span>Global Portrait Lock & Zero Bloat</span>
              </div>
            </div>
          </div>

          <!-- Buttons -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="https://play.google.com/store/apps/details?id=com.nooraya.app"
              target="_blank"
              rel="noopener noreferrer"
              class="glass-button-primary px-6 py-3.5 rounded-2xl text-sm font-semibold inline-flex items-center gap-2"
            >
              <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.198-.124-.316-.341-.316-.583V2.397c0-.242.118-.459.315-.583zm11.37 11.37l2.42 2.42-12.012 6.864 9.592-9.284zm0-2.368L5.387 1.532l12.012 6.864-2.42 2.42zM16.166 12l2.844-2.844 3.738 2.136c.74.423.74 1.109 0 1.532l-3.738 2.136L16.166 12z"/>
              </svg>
              <span>Download on Google Play</span>
            </a>
            <a href={`${base}/privacy`} class="px-5 py-3 rounded-2xl text-sm font-semibold glass-button-secondary">
              Privacy Policy
            </a>
          </div>
        </div>

        <!-- Phone Preview Mockup -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="w-[280px] sm:w-[320px] rounded-[36px] p-2.5 bg-gradient-to-b from-white/20 via-white/5 to-white/10 shadow-2xl border border-white/20 backdrop-blur-xl">
            <img
              src={noorayaScreenshot}
              alt="Nooraya Interface"
              class="w-full h-auto rounded-[28px] object-cover"
            />
          </div>
        </div>
      </div>
    </div>

    <!-- Future Pipeline Teasers -->
    <div class="space-y-6">
      <div class="flex items-center justify-between">
        <div>
          <h3 class="text-xl font-bold text-white tracking-tight">In The Lab / Upcoming Pipeline</h3>
          <p class="text-xs text-gray-400 mt-0.5">Projects currently being designed by Shoptic Technologies engineers.</p>
        </div>
        <span class="text-xs px-3 py-1 rounded-full glass-panel text-gray-400">Roadmap 2026</span>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Upcoming 1 -->
        <div class="glass-card rounded-2xl p-6 space-y-3 border border-white/10">
          <div class="flex items-center justify-between">
            <div class="text-2xl">⚡</div>
            <span class="text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-cyan-500/10 text-cyan-300 border border-cyan-500/20">
              In Architecture Phase
            </span>
          </div>
          <h4 class="text-base font-bold text-white">Focus & Mindfulness Utility</h4>
          <p class="text-xs text-gray-400 leading-relaxed">
            A minimalist deep-focus timer and soundscape synthesizer leveraging neuroscience-backed binaural frequencies and liquid animations.
          </p>
        </div>

        <!-- Upcoming 2 -->
        <div class="glass-card rounded-2xl p-6 space-y-3 border border-white/10">
          <div class="flex items-center justify-between">
            <div class="text-2xl">📊</div>
            <span class="text-[10px] font-semibold uppercase tracking-wider px-2.5 py-1 rounded-full bg-indigo-500/10 text-indigo-300 border border-indigo-500/20">
              Prototyping
            </span>
          </div>
          <h4 class="text-base font-bold text-white">Smart Routine & Habit Tracker</h4>
          <p class="text-xs text-gray-400 leading-relaxed">
            An offline-first personal progression tracker designed with zero subscription fatigue, end-to-end device storage, and intuitive haptic widgets.
          </p>
        </div>
      </div>
    </div>
  </div>
</Layout>
