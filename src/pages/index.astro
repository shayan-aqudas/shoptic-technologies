---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const logoSrc = `${base}/images/shoptic-logo.svg`;
---

<Layout
  title="Shoptic Technologies — Engineering the Future of Liquid Mobile Software"
  description="Shoptic Technologies is an independent software studio building high-performance mobile apps, mindful utilities, and tactile liquid glass digital products."
>
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16 text-center relative">
    <!-- Top Studio Pill -->
    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full nooraya-pill text-xs font-semibold tracking-wide text-cyan-300 mb-8 border border-cyan-500/30">
      <span class="w-2 h-2 rounded-full bg-cyan-400 animate-ping"></span>
      <span>Software Engineering Studio</span>
    </div>

    <!-- Main Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.12]">
      Crafting Software with <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-emerald-400 to-indigo-400">Liquid Glass</span> Architecture.
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Shoptic Technologies is a modern digital studio designing fast, privacy-first mobile applications, intelligent lifestyle utilities, and tactile user experiences built with mathematical rigor.
    </p>

    <!-- Hero CTA Buttons -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href={`${base}/apps`}
        class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-bold gold-liquid-btn inline-flex items-center gap-2.5"
      >
        <span>Explore Our Products</span>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
        </svg>
      </a>
      <a
        href={`${base}/about`}
        class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold glass-btn-secondary inline-flex items-center gap-2"
      >
        <span>About Our Studio</span>
      </a>
    </div>

    <!-- Stats Glass Ribbon -->
    <div class="mt-16 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-4xl mx-auto">
      <div class="nooraya-glass rounded-[26px] p-6 text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">100%</div>
        <div class="text-xs text-gray-400 mt-1 font-semibold uppercase tracking-wider">Privacy by Design</div>
      </div>
      <div class="nooraya-glass rounded-[26px] p-6 text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-white">60 FPS</div>
        <div class="text-xs text-gray-400 mt-1 font-semibold uppercase tracking-wider">Locked Fluidity</div>
      </div>
      <div class="nooraya-glass rounded-[26px] p-6 text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-transparent bg-clip-text bg-gradient-to-r from-emerald-400 to-cyan-400">0 kb</div>
        <div class="text-xs text-gray-400 mt-1 font-semibold uppercase tracking-wider">Tracking Bloat</div>
      </div>
      <div class="nooraya-glass rounded-[26px] p-6 text-center">
        <div class="text-3xl sm:text-4xl font-extrabold text-white">&lt;24h</div>
        <div class="text-xs text-gray-400 mt-1 font-semibold uppercase tracking-wider">Support Turnaround</div>
      </div>
    </div>
  </section>

  <!-- Studio Domain Pillars (Interactive Liquid Glass Grid) -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-14">
      <div class="text-xs uppercase tracking-widest font-bold text-cyan-400">Core Engineering Pillars</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        How We Build Digital Experiences
      </h2>
      <p class="text-gray-400 text-sm max-w-lg mx-auto mt-2">
        Every product engineered by Shoptic Technologies blends mathematical performance with tangible visual beauty.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <!-- Pillar 1 -->
      <div class="nooraya-glass rounded-[32px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-cyan-400 border border-cyan-500/30">
          📱
        </div>
        <h3 class="text-lg font-bold text-white">Mobile Architecture</h3>
        <p class="text-gray-300 text-xs sm:text-sm leading-relaxed">
          Native Flutter and Kotlin engines compiled for zero-stutter execution. Battery-conscious background lifecycles and lightweight binary footprints.
        </p>
      </div>

      <!-- Pillar 2 -->
      <div class="nooraya-glass rounded-[32px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-emerald-400 border border-emerald-500/30">
          💎
        </div>
        <h3 class="text-lg font-bold text-white">Liquid Glass Interfaces</h3>
        <p class="text-gray-300 text-xs sm:text-sm leading-relaxed">
          Inspired by refractive materials and fluid motion, our applications deliver tactile feedback, double-rim specular light lines, and organic squircles.
        </p>
      </div>

      <!-- Pillar 3 -->
      <div class="nooraya-glass rounded-[32px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-indigo-400 border border-indigo-500/30">
          🛡️
        </div>
        <h3 class="text-lg font-bold text-white">Ethical User Privacy</h3>
        <p class="text-gray-300 text-xs sm:text-sm leading-relaxed">
          Zero covert profiling or personal data brokers. Heavy computations, sensors, and caches stay safely sandboxed on the user's hardware.
        </p>
      </div>
    </div>
  </section>

  <!-- Products & Portfolio Gateway Card -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="nooraya-glass rounded-[38px] p-8 sm:p-14 border border-white/15 relative overflow-hidden">
      <!-- Glow ambient background -->
      <div class="absolute -top-24 -right-24 w-[450px] h-[450px] bg-gradient-to-br from-cyan-500/15 via-emerald-500/10 to-transparent rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 items-center">
        <div class="lg:col-span-8 space-y-5">
          <div class="inline-flex items-center gap-2 px-3.5 py-1 rounded-full nooraya-pill text-xs font-semibold text-emerald-300 border border-emerald-500/30">
            <span>Portfolio & Products</span>
          </div>
          <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
            Explore Our Digital Applications
          </h2>
          <p class="text-gray-300 text-sm sm:text-base leading-relaxed max-w-xl">
            From our active flagship release — <strong>Nooraya</strong>, a sacred Islamic lifestyle companion on Google Play — to experimental utilities in our development pipeline, see how we translate engineering into everyday utility.
          </p>
          <div class="pt-2">
            <a
              href={`${base}/apps`}
              class="gold-liquid-btn px-8 py-3.5 rounded-full text-xs sm:text-sm font-bold inline-flex items-center gap-2.5 cursor-pointer"
            >
              <span>View All Products & Apps</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        </div>

        <!-- Right Visual Showcase -->
        <div class="lg:col-span-4 flex justify-center">
          <div class="nooraya-glass rounded-[32px] p-6 text-center border border-white/20 shadow-2xl space-y-4 max-w-xs w-full">
            <div class="w-16 h-16 mx-auto rounded-2xl nooraya-glass flex items-center justify-center p-2.5 border border-white/25">
              <img src={logoSrc} alt="Shoptic Technologies" class="w-10 h-10" />
            </div>
            <div>
              <div class="text-base font-bold text-white">Shoptic Ecosystem</div>
              <div class="text-xs text-gray-400 mt-0.5">Active & Pipeline Software</div>
            </div>
            <div class="flex items-center justify-center gap-2 text-xs text-emerald-400 font-semibold pt-1">
              <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
              <span>Production Verified</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="nooraya-glass rounded-[36px] p-8 sm:p-14 text-center border border-white/15 relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-5">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Partner with <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 via-emerald-400 to-indigo-400">Shoptic Technologies</span>
        </h2>
        <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
          Whether you have product inquiries, technical feedback, or business collaboration proposals, our engineering studio is always open.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a
            href={`${base}/contact`}
            class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-bold gold-liquid-btn"
          >
            Get in Touch
          </a>
          <a
            href={`${base}/about`}
            class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold glass-btn-secondary"
          >
            About Our Engineering
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
