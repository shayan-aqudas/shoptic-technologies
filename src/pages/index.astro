---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const noorayaLogo = `${base}/images/nooraya-logo.png`;
const noorayaScreenshot = `${base}/images/nooraya-screenshot.png`;
---

<Layout
  title="Shoptic Technologies — Creators of Nooraya & Liquid Glass Mobile Apps"
  description="Shoptic Technologies is a modern digital engineering studio crafting privacy-first mobile apps and spiritual lifestyle companions including Nooraya."
>
  <!-- Hero Section -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 sm:pt-24 pb-16 text-center relative">
    <!-- Glowing Arabic Calligraphy Aura -->
    <div class="mb-4 inline-block">
      <div class="relative">
        <span class="text-4xl sm:text-5xl font-bold font-serif text-[#FFE3A1] tracking-wider drop-shadow-[0_0_25px_rgba(255,213,107,0.55)]">
          نُورَايَة
        </span>
      </div>
    </div>

    <!-- Liquid Pill Badge -->
    <div>
      <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full nooraya-pill text-xs font-semibold tracking-wide text-[#FFE3A1] mb-6">
        <span class="w-2 h-2 rounded-full bg-[#FFD56B] animate-ping"></span>
        <span>Liquid Glass Mobile Studio</span>
      </div>
    </div>

    <!-- Hero Headline -->
    <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight text-white max-w-4xl mx-auto leading-[1.12]">
      Mindful Software Crafted with <span class="gold-gradient-text">Liquid Glass</span>.
    </h1>

    <!-- Subtitle -->
    <p class="mt-6 text-base sm:text-xl text-gray-300 max-w-2xl mx-auto leading-relaxed font-normal">
      Shoptic Technologies builds purposeful, privacy-first mobile applications, astronomical prayer engines, and sacred audio tools designed with obsessive material beauty.
    </p>

    <!-- Hero CTA Buttons -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-4">
      <a
        href="https://play.google.com/store/apps/details?id=com.nooraya.app"
        target="_blank"
        rel="noopener noreferrer"
        class="px-7 py-3.5 rounded-full text-xs sm:text-sm font-bold gold-liquid-btn inline-flex items-center gap-2.5"
      >
        <span>Download Nooraya App</span>
        <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
          <path d="M3.609 1.814L13.792 12 3.61 22.186c-.198-.124-.316-.341-.316-.583V2.397c0-.242.118-.459.315-.583zm11.37 11.37l2.42 2.42-12.012 6.864 9.592-9.284zm0-2.368L5.387 1.532l12.012 6.864-2.42 2.42zM16.166 12l2.844-2.844 3.738 2.136c.74.423.74 1.109 0 1.532l-3.738 2.136L16.166 12z"/>
        </svg>
      </a>
      <a
        href={`${base}/apps`}
        class="px-7 py-3.5 rounded-full text-xs sm:text-sm font-semibold glass-btn-secondary inline-flex items-center gap-2"
      >
        <span>Explore Application Portfolio</span>
      </a>
    </div>

    <!-- Live Interactive Nooraya Sky Widget Teaser -->
    <div class="mt-20 max-w-2xl mx-auto text-left">
      <!-- Sky Glass Card (Authentic Nooraya App Recreation) -->
      <div class="sky-glass-card rounded-[32px] p-6 sm:p-8 relative overflow-hidden">
        <!-- Floating Stars -->
        <div class="absolute inset-0 bg-[radial-gradient(#ffffff18_1px,transparent_1px)] [background-size:20px_20px] pointer-events-none"></div>

        <!-- Top Row: Location Pill & Hijri Date -->
        <div class="flex items-center justify-between text-xs text-gray-300 relative z-10 mb-6">
          <div class="nooraya-pill px-3 py-1.5 rounded-full inline-flex items-center gap-1.5 font-medium text-white text-[11px]">
            <svg class="w-3 h-3 text-[#38BDF8]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
            </svg>
            <span>Araria, Bihar</span>
          </div>
          <div class="flex items-center gap-1.5 text-gray-300 text-[11px] font-medium">
            <span>☽</span>
            <span>9 Jumada al-Akhirah 1448</span>
          </div>
        </div>

        <!-- Middle Row: Next Prayer & Circular Countdown Ring -->
        <div class="flex items-center justify-between relative z-10 my-4">
          <div>
            <div class="text-xs text-[#34D399] font-semibold flex items-center gap-1.5 mb-1">
              <span class="w-2 h-2 rounded-full bg-[#34D399] animate-pulse"></span>
              <span>Upcoming Prayer • الفَجْر</span>
            </div>
            <div class="text-4xl sm:text-5xl font-extrabold text-white tracking-tight">
              4:42 <span class="text-xl sm:text-2xl font-light text-gray-300">AM</span>
            </div>
            <div class="text-[11px] text-gray-400 mt-1">Fajr starts in 10h 30m</div>
          </div>

          <!-- Circular Countdown Widget -->
          <div class="w-24 h-24 rounded-full nooraya-pill flex flex-col items-center justify-center p-2 text-center border border-white/20 shadow-xl shadow-cyan-500/10">
            <span class="text-xs">☀️</span>
            <span class="text-xs font-bold text-white mt-0.5">10h 30m</span>
            <span class="text-[9px] text-gray-400 font-medium">remaining</span>
          </div>
        </div>

        <!-- Prayer Timeline Bar -->
        <div class="relative z-10 mt-6 pt-4 border-t border-white/10">
          <div class="grid grid-cols-5 gap-2 text-center text-[10px]">
            <div class="space-y-1">
              <div class="text-gray-400">Fajr</div>
              <div class="font-bold text-[#FFD56B]">4:41 AM</div>
            </div>
            <div class="space-y-1">
              <div class="text-gray-400">Dhuhr</div>
              <div class="font-semibold text-white">11:26 AM</div>
            </div>
            <div class="space-y-1">
              <div class="text-gray-400">Asr</div>
              <div class="font-semibold text-white">3:13 PM</div>
            </div>
            <div class="space-y-1">
              <div class="text-gray-400">Maghrib</div>
              <div class="font-semibold text-white">4:49 PM</div>
            </div>
            <div class="space-y-1">
              <div class="text-gray-400">Isha</div>
              <div class="font-bold text-[#FFE3A1]">6:10 PM</div>
            </div>
          </div>
        </div>
      </div>

      <!-- 4 Nooraya Signature Squircles -->
      <div class="grid grid-cols-4 gap-3 sm:gap-4 mt-4">
        <!-- Qibla -->
        <div class="nooraya-widget-box p-3 sm:p-4 text-center cursor-pointer">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-gradient-to-tr from-[#EA580C] to-[#F97316] flex items-center justify-center text-white text-lg shadow-lg shadow-orange-500/25">
            🧭
          </div>
          <div class="text-xs font-bold text-white mt-2">Qibla</div>
        </div>

        <!-- Sukoon -->
        <div class="nooraya-widget-box p-3 sm:p-4 text-center cursor-pointer">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-gradient-to-tr from-[#7C3AED] to-[#A855F7] flex items-center justify-center text-white text-lg shadow-lg shadow-purple-500/25">
            🌸
          </div>
          <div class="text-xs font-bold text-white mt-2">Sukoon</div>
        </div>

        <!-- Ringtones -->
        <div class="nooraya-widget-box p-3 sm:p-4 text-center cursor-pointer">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-gradient-to-tr from-[#059669] to-[#10B981] flex items-center justify-center text-white text-lg shadow-lg shadow-emerald-500/25">
            🔔
          </div>
          <div class="text-xs font-bold text-white mt-2">Ringtones</div>
        </div>

        <!-- Last Read -->
        <div class="nooraya-widget-box p-3 sm:p-4 text-center cursor-pointer">
          <div class="w-10 h-10 sm:w-12 sm:h-12 mx-auto rounded-2xl bg-gradient-to-tr from-[#0284C7] to-[#38BDF8] flex items-center justify-center text-white text-lg shadow-lg shadow-sky-500/25">
            📖
          </div>
          <div class="text-xs font-bold text-white mt-2">Quran</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Nooraya Flagship Deep Spotlight -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-20">
    <div class="nooraya-glass rounded-[38px] p-6 sm:p-12 lg:p-16 relative overflow-hidden border border-white/15">
      <!-- Glow ambient background -->
      <div class="absolute -top-20 -right-20 w-[450px] h-[450px] bg-[#FFD56B]/10 rounded-full blur-3xl pointer-events-none"></div>

      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
        <!-- Left: Specifications -->
        <div class="lg:col-span-7 space-y-6">
          <div class="flex items-center gap-4">
            <div class="w-18 h-18 rounded-[24px] nooraya-glass p-2 border border-white/20 shadow-2xl flex items-center justify-center">
              <img src={noorayaLogo} alt="Nooraya Icon" class="w-14 h-14 rounded-[18px]" />
            </div>
            <div>
              <div class="flex items-center gap-2.5">
                <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">Nooraya</h2>
                <span class="px-3 py-0.5 rounded-full text-[10px] font-bold bg-[#FFD56B]/15 text-[#FFE3A1] border border-[#FFD56B]/30">
                  v1.0.3 Live
                </span>
              </div>
              <p class="text-xs text-emerald-400 mt-1 font-semibold flex items-center gap-1.5">
                <span>✦</span>
                <span>Flagship Islamic Spiritual Companion</span>
              </p>
            </div>
          </div>

          <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
            Engineered exclusively with an authentic iOS-grade liquid glass interface, Nooraya is the quintessential app for daily prayer awareness, holy Quran recitations, and authentic Hadith literature.
          </p>

          <!-- Core Capability Highlights -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5 pt-2">
            <div class="nooraya-glass rounded-2xl p-4 flex items-start gap-3">
              <span class="text-lg">🕋</span>
              <div>
                <h3 class="text-xs font-bold text-white">Full Quran & Reciters</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">High-fidelity audio by world-renowned Qaris with translation.</p>
              </div>
            </div>
            <div class="nooraya-glass rounded-2xl p-4 flex items-start gap-3">
              <span class="text-lg">⏱️</span>
              <div>
                <h3 class="text-xs font-bold text-white">Location Prayer Timings</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Astronomical math with timely adhan alarm alerts.</p>
              </div>
            </div>
            <div class="nooraya-glass rounded-2xl p-4 flex items-start gap-3">
              <span class="text-lg">🧭</span>
              <div>
                <h3 class="text-xs font-bold text-white">Haptic Qibla Compass</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Sensor-driven live magnetic azimuth calculation.</p>
              </div>
            </div>
            <div class="nooraya-glass rounded-2xl p-4 flex items-start gap-3">
              <span class="text-lg">📱</span>
              <div>
                <h3 class="text-xs font-bold text-white">Global Portrait Lock</h3>
                <p class="text-[11px] text-gray-400 mt-0.5">Zero involuntary screen flipping. Completely stable.</p>
              </div>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="pt-4 flex flex-wrap items-center gap-4">
            <a
              href="https://play.google.com/store/apps/details?id=com.nooraya.app"
              target="_blank"
              rel="noopener noreferrer"
              class="gold-liquid-btn px-6 py-3.5 rounded-full text-xs sm:text-sm font-bold inline-flex items-center gap-2.5"
            >
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
                <path d="M3.609 1.814L13.792 12 3.61 22.186c-.198-.124-.316-.341-.316-.583V2.397c0-.242.118-.459.315-.583zm11.37 11.37l2.42 2.42-12.012 6.864 9.592-9.284zm0-2.368L5.387 1.532l12.012 6.864-2.42 2.42zM16.166 12l2.844-2.844 3.738 2.136c.74.423.74 1.109 0 1.532l-3.738 2.136L16.166 12z"/>
              </svg>
              <span>Download on Google Play</span>
            </a>
            <a
              href={`${base}/privacy`}
              class="glass-btn-secondary px-5 py-3 rounded-full text-xs font-semibold"
            >
              Play Store Privacy Policy
            </a>
          </div>
        </div>

        <!-- Right: Real App Screenshot inside Liquid Glass Mockup Frame -->
        <div class="lg:col-span-5 flex justify-center">
          <div class="relative group">
            <!-- Amber Aura Glow -->
            <div class="absolute inset-0 bg-gradient-to-tr from-[#FFD56B]/20 via-[#34D399]/15 to-transparent rounded-[44px] blur-2xl -z-10 group-hover:scale-105 transition-transform duration-500"></div>
            
            <!-- Phone Glass Frame -->
            <div class="w-[280px] sm:w-[310px] rounded-[40px] p-2.5 bg-gradient-to-b from-white/25 via-white/8 to-white/12 shadow-[0_30px_70px_rgba(0,0,0,0.9)] border border-white/25 backdrop-blur-2xl">
              <img
                src={noorayaScreenshot}
                alt="Nooraya Interface Mockup"
                class="w-full h-auto rounded-[32px] object-cover shadow-inner"
              />
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Studio Craft Pillars -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="text-center mb-14">
      <div class="text-xs uppercase tracking-widest font-bold text-[#FFD56B]">Our Foundation</div>
      <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight mt-2">
        Why Shoptic Technologies?
      </h2>
      <p class="text-gray-400 text-sm max-w-lg mx-auto mt-2">
        We adhere to stringent engineering principles: zero bloat, authentic privacy, and lasting quality.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="nooraya-glass rounded-[28px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-[#FFD56B]">
          🛡️
        </div>
        <h3 class="text-lg font-bold text-white">Absolute Data Privacy</h3>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
          We never track historical user locations or sell telemetry to brokers. Astronomical calculations occur strictly within on-device sandboxes.
        </p>
      </div>

      <div class="nooraya-glass rounded-[28px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-[#34D399]">
          💎
        </div>
        <h3 class="text-lg font-bold text-white">Genuine Liquid Glass</h3>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
          Multi-pass refractive rendering, double-rim specular light lines, and ergonomic squircles create an interface that feels physically tactile.
        </p>
      </div>

      <div class="nooraya-glass rounded-[28px] p-8 space-y-4">
        <div class="w-12 h-12 rounded-2xl nooraya-pill flex items-center justify-center text-xl text-[#38BDF8]">
          ⚡
        </div>
        <h3 class="text-lg font-bold text-white">Sub-Millisecond Engine</h3>
        <p class="text-gray-400 text-xs sm:text-sm leading-relaxed">
          Optimized native compilation, battery-preserving background timers, and seamless stream audio playback sustain locked 60 FPS fluidity.
        </p>
      </div>
    </div>
  </section>

  <!-- Bottom CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 py-16">
    <div class="nooraya-glass rounded-[36px] p-8 sm:p-14 text-center border border-white/15 relative overflow-hidden">
      <div class="max-w-2xl mx-auto space-y-5">
        <h2 class="text-3xl sm:text-4xl font-extrabold text-white tracking-tight">
          Join Millions on the <span class="gold-gradient-text">Nooraya</span> Journey
        </h2>
        <p class="text-gray-300 text-sm sm:text-base leading-relaxed">
          Download Nooraya on Android and experience the elegance of sacred mindful utilities.
        </p>
        <div class="pt-4 flex flex-wrap justify-center gap-4">
          <a
            href="https://play.google.com/store/apps/details?id=com.nooraya.app"
            target="_blank"
            rel="noopener noreferrer"
            class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-bold gold-liquid-btn"
          >
            Get on Google Play
          </a>
          <a
            href={`${base}/contact`}
            class="px-8 py-3.5 rounded-full text-xs sm:text-sm font-semibold glass-btn-secondary"
          >
            Contact Developer Desk
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
