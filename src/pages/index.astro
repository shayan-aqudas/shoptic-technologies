---
import Layout from '../layouts/Layout.astro';
import Terminal from '../components/Terminal.astro';
import SectionHead from '../components/SectionHead.astro';
import Nooraya from '../components/Nooraya.astro';
import CTA from '../components/CTA.astro';
import { ArrowRight, ArrowUpRight, Smartphone, Globe, PenTool, ShieldCheck } from '@lucide/astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const services = [
  { icon: Smartphone, title: 'Mobile apps', text: 'Android and iOS apps in Flutter and Kotlin. Smooth, battery-friendly and built to keep working for years.', tags: ['flutter', 'kotlin', 'play store'] },
  { icon: Globe, title: 'Websites & web apps', text: 'Fast, search-friendly websites and web platforms, from a launch page to a complete product.', tags: ['astro', 'tailwind', 'cloudflare'] },
  { icon: PenTool, title: 'Product & UI design', text: 'Interfaces that feel calm and obvious. Flows, prototypes, design systems and brand identity.', tags: ['ui / ux', 'design systems', 'branding'] },
  { icon: ShieldCheck, title: 'Privacy & performance', text: 'Privacy-first architecture, on-device processing and profiling until every screen runs smooth.', tags: ['on-device', '60 fps', 'audits'] },
];
const steps = [
  { t: 'Discover', d: 'We start with the problem, the people it affects and what success looks like.' },
  { t: 'Design', d: 'Flows, prototypes and a visual system before any production code is written.' },
  { t: 'Engineer', d: 'Clean architecture, tested builds and performance checks on real devices.' },
  { t: 'Ship & support', d: 'Store release, monitoring and steady updates long after launch day.' },
];
const stack = ['Flutter', 'Dart', 'Kotlin', 'Android', 'Firebase', 'SQLite', 'Astro', 'Tailwind CSS', 'Cloudflare', 'Google Play'];
---

<Layout>
  <!-- Hero -->
  <section class="hero">
    <div class="wrap hero-grid">
      <div>
        <a href={`${base}/apps`} class="pill-link reveal"><span class="tag">new</span>Nooraya is live on Google Play<ArrowUpRight /></a>
        <h1 class="display reveal" style="--d:80ms;font-size:clamp(2.8rem,5.3vw,4.9rem)">
          <span class="text-silver">Software that</span><br /><span class="text-silver">feels </span><span class="text-ember">effortless</span><span class="caret"></span>
        </h1>
        <p class="lead reveal" style="--d:160ms">
          Shoptic Technologies is an independent software studio. We design and engineer fast, privacy-first
          mobile apps and digital products that people enjoy using every day.
        </p>
        <div class="cta-row reveal" style="--d:240ms">
          <a href={`${base}/contact`} class="btn btn-primary">Start a project <ArrowRight class="go" /></a>
          <a href={`${base}/apps`} class="btn btn-glass">Explore products</a>
        </div>
        <div class="hero-meta reveal" style="--d:320ms">
          <span class="chip"><span class="dot"></span>mobile</span>
          <span class="chip"><span class="dot"></span>web</span>
          <span class="chip"><span class="dot"></span>design</span>
        </div>
      </div>
      <div class="reveal" style="--d:200ms"><Terminal /></div>
    </div>
  </section>

  <!-- Stats -->
  <section class="wrap">
    <div class="glass stats reveal">
      <div class="stat"><div class="v text-ember">Live</div><div class="l">Nooraya on Google Play</div></div>
      <div class="stat"><div class="v">60 fps</div><div class="l">smooth UI target on every screen</div></div>
      <div class="stat"><div class="v">On-device</div><div class="l">your data stays on your phone where possible</div></div>
      <div class="stat"><div class="v">24–48h</div><div class="l">support response time</div></div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="wrap">
      <SectionHead num="01" label="what we do" title="Everything a product needs,<br/>under one roof." sub="From the first sketch to the store listing, one small team owns the whole journey, so nothing gets lost between design and code." />
      <div class="cards-2">
        {services.map((s, i) => (
          <div class="glass card lift reveal" style={`--d:${i * 80}ms`}>
            <div class="icon-tile"><s.icon /></div>
            <h3 class="h3">{s.title}</h3>
            <p class="body">{s.text}</p>
            <div class="tags">{s.tags.map((t) => <span class="chip">{t}</span>)}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured product -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <SectionHead num="02" label="featured product" title="Nooraya, our flagship app." sub="Proof of how we work: a polished, privacy-respecting app used every day, built and maintained in-house." />
      <Nooraya />
    </div>
  </section>

  <!-- Process -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <SectionHead num="03" label="how we work" title="From idea to app store,<br/>without the chaos." />
      <div class="steps">
        {steps.map((s, i) => (
          <div class="glass step lift reveal" style={`--d:${i * 90}ms`}>
            <div class="n"><b>//</b> step {String(i + 1).padStart(2, '0')}</div>
            <div class="big">{String(i + 1).padStart(2, '0')}</div>
            <h3 class="h3" style="margin-top:1.2rem">{s.t}</h3>
            <p class="body mt-2 text-[15px]">{s.d}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section class="section" style="padding-top:0">
    <div class="wrap">
      <SectionHead num="04" label="our stack" title="Modern tools, chosen for longevity." center />
    </div>
    <div class="marquee reveal">
      <div class="marquee-track">
        {[...stack, ...stack].map((t) => <span class="chip"><span class="dot"></span>{t}</span>)}
      </div>
    </div>
    <div class="marquee rev reveal">
      <div class="marquee-track">
        {[...stack.slice().reverse(), ...stack.slice().reverse()].map((t) => <span class="chip">{t}</span>)}
      </div>
    </div>
  </section>

  <CTA />
</Layout>
